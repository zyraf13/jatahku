# Neon: DATABASE_URL = connection string "pooled" (app), DIRECT_URL = "direct" (migrate).
# Pilih region Singapura (ap-southeast-1) biar dari Indonesia cepat.
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/jatahku?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@ep-xxx.ap-southeast-1.aws.neon.tech/jatahku?sslmode=require"

# Auth (§9.1). Kosong = mode dev mock (login instan tanpa Google).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET="dev-secret-ganti-di-produksi"
AUTH_URL="http://localhost:3000"
